# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock file comment if you want to commit it (recommended to KEEP this file)
# .terraform.lock.hcl

# Plan files
*.tfplan
plan.out
tfplan

# Sensitive / local env
.env
.env.*
!.env.example
*.pem
*.key

# AWS credentials (never commit)
.aws/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Logs / temp
*.log
*.tmp
*.temp
